{
  "name": "etbsavemanager",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm sync-version && vite",
    "build": "pnpm sync-version && node scripts/optimize-images.mjs && vue-tsc --noEmit && vite build",
    "optimize-images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "sync-version": "node scripts/sync-version.js",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "format": "prettier --check src",
    "format:fix": "prettier --write src"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.2",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.13.32",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@vue-flow/background": "^1.1.3",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.1.3",
    "chart.js": "^4.5.0",
    "dompurify": "^3.4.12",
    "gsap": "^3.13.0",
    "markdown-it": "^15.0.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-sanitizer": "^0.4.3",
    "pinia": "^4.0.2",
    "pinyin-pro": "^3.28.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "terser": "^5.44.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
